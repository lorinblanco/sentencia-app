function tipoFromCalculos(calculos, datos) {
  if (datos?.tipoAccion) return datos.tipoAccion;
  if (datos?.tipo_accion_detectado?.toUpperCase().includes('REVISI')) return 'REVISION_CM';
  if (calculos?.esAccidente === false) return 'ENFERMEDAD';
  return 'ACCIDENTE';
}

function tieneIncapacidadPsiquica(datos) {
  const psiAcr = datos?.incapacidad_acreditada_pericia?.psiquica_porcentaje;
  const psiPerito = datos?.pericia_psiquiatrica?.incapacidad_porcentaje;
  const tienePeritoPsi = datos?.pericia_psiquiatrica?.tiene === true;
  if (psiAcr != null && Number(psiAcr) > 0) return true;
  if (tienePeritoPsi && psiPerito != null && Number(psiPerito) > 0) return true;
  return false;
}

export function terminoSecuelas(datos) {
  return tieneIncapacidadPsiquica(datos) ? 'psicofísica' : 'física';
}

function huboImpugnacionReal(datos) {
  const imps = datos?.impugnaciones_pericia;
  if (!Array.isArray(imps) || imps.length === 0) return false;
  const fechaDictamen = datos?.pericia_medica?.fecha_dictamen;
  const parse = (f) => {
    if (!f) return null;
    const m = String(f).match(/(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})/);
    if (!m) return null;
    let [_, d, mo, y] = m;
    if (y.length === 2) y = '20' + y;
    return new Date(Number(y), Number(mo) - 1, Number(d)).getTime();
  };
  const fd = parse(fechaDictamen);
  return imps.some(i => {
    const fi = parse(i?.fecha);
    if (fd == null || fi == null) return !!i?.fecha;
    return fi > fd;
  });
}

const REGLA_DATOS = `Datos exactos, CONCISO. Dato estructural ausente en todas las fuentes → "[FALTA: descripción]". Prohibidas: "si bien no surge...", "se desprende que...", "puede inferirse...", "presumiblemente...", "no habiendo producido prueba técnica que desvirtúe...". NUNCA atribuyas al perito el % reclamado. NUNCA inventes perito psi. NUNCA confundas contestación con impugnación.

`;

function bloqueValoresPrecalculados(calculos, config, datos) {
  if (!calculos) {
    return '\n# VALORES\n(Sin cálculos → indica RECHAZO de la demanda. Redactá en consecuencia.)\n';
  }

  const tipo = tipoFromCalculos(calculos, datos);
  const esEnf = tipo === 'ENFERMEDAD';
  const fechaContingencia = config?.fecha_accidente
    || datos?.accidente?.fecha
    || '[FALTA: fecha del evento]';
  const rfecha = config?.ripte_fecha || 'último publicado';

  const bloque20 = calculos.esAccidente
    ? `  - +20% (art. 3 ley 26.773): $ ${calculos.fmt?.adicional20 || ''}`
    : `  - NO se aplica +20% (es enfermedad, no accidente)`;

  const fuenteNote = calculos.fuente === 'planilla_calm'
    ? '\nFUENTE: Planilla CALM. El % de la planilla es VINCULANTE.\n'
    : '';

  return `
# VALORES NUMÉRICOS A USAR (TEXTUAL — no inventar otros)

CASO:
  - Tipo: ${tipo === 'ACCIDENTE' ? 'ACCIDENTE DE TRABAJO' : tipo === 'ENFERMEDAD' ? 'ENFERMEDAD PROFESIONAL' : 'ACCIÓN DE REVISIÓN CM (Ley 15.057)'}
  - Fecha ${esEnf ? 'primera manifestación' : 'accidente'}: ${fechaContingencia}
  - Edad al evento: ${calculos.edad || '[FALTA]'} años
  - % incapacidad ACREDITADA: ${calculos.porcentaje || '[FALTA]'}%
  - Naturaleza: ${terminoSecuelas(datos).toUpperCase()} (usá este término)

RIPTE:
  - Mes ${esEnf ? 'evento' : 'accidente'}: $ ${calculos.fmt?.ripteAccidente || ''}
  - Actual (${rfecha}): $ ${calculos.fmt?.ripteActual || ''}
  - Coef: ${calculos.coefRipte != null ? Number(calculos.coefRipte).toFixed(4) : ''}

IBM:
  - IBM bruto AFIP: $ ${calculos.fmt?.ibmBruto || ''}
  - Intereses BNA: $ ${calculos.fmt?.intereseseBNA || ''}
  - IBM con intereses: $ ${calculos.fmt?.ibmConIntereses || ''}
  - Hipótesis (a) BNA: $ ${calculos.fmt?.hipotesisA || ''}
  - IBM con RIPTE: $ ${calculos.fmt?.ibmRIPTE || ''}
  - Hipótesis (b) RIPTE (sin +20%): $ ${calculos.fmt?.hipotesisB || ''}

CONDENA:
${bloque20}
  - TOTAL: $ ${calculos.fmt?.total || ''}
  - En letras: ${calculos.totalEnLetras || ''}
${fuenteNote}
Cualquier monto que insertes DEBE estar en esta lista. % = ÚNICO valor "ACREDITADA".
`;
}

