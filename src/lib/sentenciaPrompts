    "incapacidad_fisica_porcentaje": null,
    "factores_ponderacion": { "porcentaje": null }
  },
  "pericia_psiquiatrica": { "tiene": false, "perito_nombre": "", "incapacidad_porcentaje": null },
  "ibm_bruto_afip": null,
  "denuncia_inconst_ley_23928": false,
  "denuncia_inconst_ley_24432": false,
  "excepcion_prescripcion_opuesta": false,
  "alta_con_incapacidad": false
