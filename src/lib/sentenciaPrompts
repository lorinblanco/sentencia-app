  const bloqueAdicional20 = calculos.esAccidente
    ? `  - Incremento 20% (art. 3 ley 26.773): $ ${calculos.fmt?.adicional20 || ''}`
    : `  - NO se aplica +20% — es enfermedad profesional, no accidente`;

  const fuenteNote = calculos.fuente === 'planilla_calm'
    ? '\nFUENTE: Planilla del Instituto de Derecho del Trabajo del CALM. El % de incapacidad cargado en la planilla es el VALOR VINCULANTE para la indemnización.\n'
