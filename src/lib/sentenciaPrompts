    || datos?.tipo_accion?.toUpperCase().includes('ENFERMEDAD');

  const terminoHecho = esEnfermedad ? 'la enfermedad profesional' : 'el accidente de trabajo';
  const terminoFecha = esEnfermedad ? 'fecha de primera manifestación invalidante' : 'fecha del accidente';

  return REGLA_DATOS +
`TEXTO DEL EXPEDIENTE (demanda, contestación, prueba):

${chunks.header}

DATOS YA EXTRAÍDOS (fuente PRIMARIA — usalos directamente en el texto):

${JSON.stringify(datos, null, 2)}

# TIPO DE CASO

Este caso es: ${esEnfermedad ? 'ENFERMEDAD PROFESIONAL' : 'ACCIDENTE DE TRABAJO'}.
Usá el término "${terminoHecho}" en lugar de "accidente" donde corresponda.

# TAREA

Redactá ÚNICAMENTE la sección "Antecedentes:" del voto principal de la Primera Cuestión. Vas a redactar como ${j1}.

