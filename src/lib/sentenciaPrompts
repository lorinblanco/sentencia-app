function tipoFromCalculos(calculos, datos) {
  if (datos?.tipoAccion) return datos.tipoAccion;
  if (datos?.tipo_accion_detectado?.toUpperCase().includes('REVISI')) return 'REVISION_CM';
  if (calculos?.esAccidente === false) return 'ENFERMEDAD';
  return 'ACCIDENTE';
}

// --- NUEVO v2.6: distinción física vs psicofísica -----------------------------
function tieneIncapacidadPsiquica(datos) {
  const psiAcr = datos?.incapacidad_acreditada_pericia?.psiquica_porcentaje;
  const psiPerito = datos?.pericia_psiquiatrica?.incapacidad_porcentaje;
  const tienePeritoPsi = datos?.pericia_psiquiatrica?.tiene === true;
  if (psiAcr != null && Number(psiAcr) > 0) return true;
  if (tienePeritoPsi && psiPerito != null && Number(psiPerito) > 0) return true;
  return false;
}

export function terminoSecuelas(datos) {
  // Devuelve 'psicofísica' si hay incapacidad psíquica acreditada; sino 'física'.
  return tieneIncapacidadPsiquica(datos) ? 'psicofísica' : 'física';
}

// --- NUEVO v2.6: detección de impugnación REAL (posterior al dictamen) ---------
function huboImpugnacionReal(datos) {
  const imps = datos?.impugnaciones_pericia;
  if (!Array.isArray(imps) || imps.length === 0) return false;
  const fechaDictamen = datos?.pericia_medica?.fecha_dictamen;
  // Si tenemos fecha de dictamen, exigimos que al menos una impugnación sea
  // posterior. Si no hay fechas comparables, confiamos en el flag del extract
  // (que ya filtra contestación vs impugnación).
  const parse = (f) => {
    if (!f) return null;
    const m = String(f).match(/(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})/);
    if (!m) return null;
    let [_, d, mo, y] = m;
    if (y.length === 2) y = '20' + y;
    return new Date(Number(y), Number(mo) - 1, Number(d)).getTime();
  };
  const fd = parse(fechaDictamen);
  return imps.some(i => {
    const fi = parse(i?.fecha);
    if (fd == null || fi == null) return !!i?.fecha; // sin fechas: confiar en presencia
    return fi > fd; // impugnación posterior al dictamen = real
  });
}

