    "fecha_dictamen": ""
  },
  "impugnaciones_pericia": [{ "fecha": "", "impugnante": "", "fecha_contestacion_perito": "" }],
  "pericia_psiquiatrica": {
    "tiene": false,
    "perito_nombre": "",
