export function buildExtractUserPrompt(chunks) {
  const fullText = chunks.fullText || '';
  let cuerpoExpediente;

  if (fullText && fullText.length > 0) {
    const tramos = [];
    tramos.push(`=== TRAMO 1 — INICIO (demanda y contestación) ===\n` + fullText.slice(0, 30000));
    if (chunks.pericia && chunks.pericia.length > 200) {
      tramos.push(`=== TRAMO 2 — DICTAMEN PERICIAL ===\n` + chunks.pericia.slice(0, 8000));
    } else if (fullText.length > 30000) {
      tramos.push(`=== TRAMO 2 — MEDIO (probable pericia) ===\n` + fullText.slice(30000, Math.min(50000, fullText.length)));
    }
    if (chunks.final && chunks.final.length > 200) {
      tramos.push(`=== TRAMO 3 — FINAL (impugnaciones, oficios) ===\n` + chunks.final.slice(0, 5000));
    } else if (fullText.length > 50000) {
      tramos.push(`=== TRAMO 3 — FINAL ===\n` + fullText.slice(-6000));
    }
    cuerpoExpediente = tramos.join('\n\n');
  } else {
    const tramos = [];
    if (chunks.header) {
      tramos.push(`=== TRAMO 1 — INICIO ===\n` + chunks.header.slice(0, 16000));
      if (chunks.header.length > 16000) {
        tramos.push(`=== TRAMO 2 — CONTINUACIÓN ===\n` + chunks.header.slice(16000, 28000));
      }
    }
    if (chunks.pericia) tramos.push(`=== TRAMO 3 — PERICIA ===\n` + chunks.pericia.slice(0, 8000));
    if (chunks.final) tramos.push(`=== TRAMO 4 — FINAL ===\n` + chunks.final.slice(0, 4000));
    cuerpoExpediente = tramos.join('\n\n');
  }

  return `Del expediente MEV (Tribunal del Trabajo N° 5 Quilmes), extraé SOLO este JSON (sin markdown ni texto adicional):

