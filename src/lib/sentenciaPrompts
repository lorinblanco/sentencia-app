export function buildResolucionUserPrompt(chunks, datos, config) {
  const tipo = tipoFromCalculos(null, datos);
  const esEnf = tipo === 'ENFERMEDAD';
  const esRev = tipo === 'REVISION_CM';
  const terminoHecho = esEnf ? 'la enfermedad profesional'
    : esRev ? 'el hecho denunciado'
    : 'el accidente de trabajo';
