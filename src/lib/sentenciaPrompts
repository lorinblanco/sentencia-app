function tipoFromCalculos(calculos, datos) {
  // tipoAccion 'ACCIDENTE' | 'ENFERMEDAD' | 'REVISION_CM'
  if (datos?.tipoAccion) return datos.tipoAccion;
  if (datos?.tipo_accion_detectado?.toUpperCase().includes('REVISI')) return 'REVISION_CM';
  if (calculos?.esAccidente === false) return 'ENFERMEDAD';
  return 'ACCIDENTE';
}

const REGLA_DATOS = `RECORDATORIO: usá TODOS los datos exactos del expediente y del JSON. Si un dato es estructuralmente necesario y NO figura en NINGUNA fuente, escribí literal "[FALTA: descripción]". NUNCA escribas frases como "si bien no surge...", "se desprende que...", "puede inferirse...", "presumiblemente...". NUNCA atribuyas al perito el % que reclama la demanda. NUNCA inventes un perito psicólogo si solo hubo legista.

`;

function bloqueValoresPrecalculados(calculos, config, datos) {
  if (!calculos) {
    return '\n# VALORES NUMÉRICOS A USAR\n\n(No hay cálculos disponibles — esto indica RECHAZO de la demanda. Redactá la sentencia en consecuencia.)\n';
  }

  const tipo = tipoFromCalculos(calculos, datos);
  const esEnf = tipo === 'ENFERMEDAD';
  const fechaContingencia = config?.fecha_accidente
    || datos?.accidente?.fecha
    || '[FALTA: fecha del evento]';
  const rfecha = config?.ripte_fecha || 'último publicado';

  const bloqueAdicional20 = calculos.esAccidente
    ? `  - Incremento 20% (art. 3 ley 26.773): $ ${calculos.fmt?.adicional20 || ''}`
    : `  - NO se aplica +20% — es enfermedad profesional, no accidente`;

  const fuenteNote = calculos.fuente === 'planilla_calm'
    ? '\nFUENTE: Planilla del Instituto de Derecho del Trabajo del CALM. El % de incapacidad cargado en la planilla es el VALOR VINCULANTE para la indemnización.\n'
    : '';

  return `
# VALORES NUMÉRICOS A USAR (USAR EXACTAMENTE ESTOS — NO INVENTAR OTROS)

DATOS DEL CASO:
  - Tipo: ${tipo === 'ACCIDENTE' ? 'ACCIDENTE DE TRABAJO' : tipo === 'ENFERMEDAD' ? 'ENFERMEDAD PROFESIONAL' : 'ACCIÓN DE REVISIÓN DE COMISIÓN MÉDICA (Ley 15.057)'}
  - Fecha de ${esEnf ? 'primera manifestación invalidante' : 'accidente'}: ${fechaContingencia}
  - Edad del actor al evento: ${calculos.edad || '[FALTA: edad]'} años
  - Porcentaje de incapacidad ACREDITADA (= el que va en la condena): ${calculos.porcentaje || '[FALTA: % acreditado]'}%

VALORES RIPTE:
  - RIPTE al mes del ${esEnf ? 'evento' : 'accidente'}: $ ${calculos.fmt?.ripteAccidente || ''}
  - RIPTE actual (${rfecha}): $ ${calculos.fmt?.ripteActual || ''}
  - Coeficiente RIPTE: ${calculos.coefRipte != null ? Number(calculos.coefRipte).toFixed(4) : ''}

IBM Y HIPÓTESIS:
  - IBM bruto AFIP (mensual): $ ${calculos.fmt?.ibmBruto || ''}
  - Intereses tasa activa BNA acumulados: $ ${calculos.fmt?.intereseseBNA || ''}
  - IBM con intereses BNA: $ ${calculos.fmt?.ibmConIntereses || ''}
  - Indemnización hipótesis (a) tasa activa BNA: $ ${calculos.fmt?.hipotesisA || ''}
  - IBM con RIPTE: $ ${calculos.fmt?.ibmRIPTE || ''}
  - Indemnización hipótesis (b) RIPTE (sin +20%): $ ${calculos.fmt?.hipotesisB || ''}

CONDENA FINAL:
${bloqueAdicional20}
