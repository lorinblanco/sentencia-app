// Texto fijo del tribunal. No pasa por el LLM, se concatena por código.
// La variable es "por mayoría" vs "por unanimidad" según cómo vota Weiss.
 
export function buildEncabezadoSentencia(varianteWeiss) {
  // varianteWeiss: 1 → discrepa con fundamento (caso "Barrios")
