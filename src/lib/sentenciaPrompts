export function buildExtractUserPrompt(chunks) {
  const fullText = chunks.fullText || '';
  let cuerpoExpediente;
 
  if (fullText && fullText.length > 0) {
    // Estrategia full-text: tres tramos del expediente completo, etiquetados.
    const tramos = [];
 
    // TRAMO 1: arranque del expediente (demanda + contestación + lo que venga)
    tramos.push(
      `=== TRAMO 1 — INICIO DEL EXPEDIENTE (demanda y contestación de demanda) ===\n` +
      fullText.slice(0, 30000)
    );
 
    // TRAMO 2: dictamen pericial. Prefiero chunks.pericia (si existe) porque
    // está ya identificado por buildChunks; si no, tomo el tramo del medio.
    if (chunks.pericia && chunks.pericia.length > 200) {
      tramos.push(
        `=== TRAMO 2 — DICTAMEN PERICIAL MÉDICO ===\n` +
        chunks.pericia.slice(0, 8000)
      );
    } else if (fullText.length > 30000) {
      tramos.push(
        `=== TRAMO 2 — TRAMO MEDIO DEL EXPEDIENTE (probable dictamen pericial) ===\n` +
        fullText.slice(30000, Math.min(50000, fullText.length))
      );
    }
 
    // TRAMO 3: final del expediente (impugnaciones, alegatos, autos)
    if (chunks.final && chunks.final.length > 200) {
      tramos.push(
        `=== TRAMO 3 — FINAL DEL EXPEDIENTE (impugnaciones, escritos posteriores) ===\n` +
        chunks.final.slice(0, 5000)
      );
    } else if (fullText.length > 50000) {
      tramos.push(
        `=== TRAMO 3 — FINAL DEL EXPEDIENTE ===\n` +
        fullText.slice(-6000)
      );
    }
 
    cuerpoExpediente = tramos.join('\n\n');
  } else {
    // Fallback sin fullText: combinar chunks individuales con slicing amplio
    const tramos = [];
    if (chunks.header) {
      tramos.push(
        `=== TRAMO 1 — INICIO DEL EXPEDIENTE ===\n` +
        chunks.header.slice(0, 16000)
      );
      if (chunks.header.length > 16000) {
        tramos.push(
          `=== TRAMO 2 — CONTINUACIÓN DEL EXPEDIENTE (probable contestación) ===\n` +
          chunks.header.slice(16000, 28000)
        );
      }
    }
    if (chunks.pericia) {
      tramos.push(
        `=== TRAMO 3 — DICTAMEN PERICIAL MÉDICO ===\n` +
        chunks.pericia.slice(0, 8000)
      );
    }
    if (chunks.final) {
      tramos.push(
        `=== TRAMO 4 — FINAL DEL EXPEDIENTE ===\n` +
        chunks.final.slice(0, 4000)
      );
    }
    cuerpoExpediente = tramos.join('\n\n');
  }
 
  return `Del siguiente texto de un expediente JUDICIAL DIGITAL (MEV) del Tribunal del Trabajo N° 5 de Quilmes, extraé exactamente estos datos. Respondé SOLO el JSON, sin texto adicional ni bloques de markdown:
 
