// HELPERS
// =============================================================================

/**
 * Devuelve el RIPTE de un mes específico en formato AR ("8.665,19").
 * @param {string} yyyymm  Formato "YYYY-MM" (ej: "2021-03")
 * @returns {string|null}  Valor en formato AR, o null si no existe.
 */
export function getRipteMes(yyyymm) {
  return RIPTE_HISTORICO[yyyymm] || null
}

/**
 * Devuelve el RIPTE del mes correspondiente a una fecha de accidente.
 * @param {string} fechaISO  Fecha en formato "YYYY-MM-DD"
 * @returns {string|null}    Valor del RIPTE de ese mes en formato AR.
 */
export function getRipteFechaAccidente(fechaISO) {
  if (!fechaISO || !/^\d{4}-\d{2}-\d{2}$/.test(fechaISO)) return null
  return getRipteMes(fechaISO.slice(0, 7))
}

/**
 * Devuelve el último RIPTE publicado en la serie.
 * Útil para precargar el campo "RIPTE actual" cuando el endpoint /api/ripte
 * no está disponible o falla.
 * @returns {{mes: string, valor: string}}
 */
export function getRipteUltimo() {
  const claves = Object.keys(RIPTE_HISTORICO).sort()
  const ultimaClave = claves[claves.length - 1]
  return { mes: ultimaClave, valor: RIPTE_HISTORICO[ultimaClave] }
}

/**
 * Convierte el formato AR ("8.665,19") a número JS (8665.19).
 * Útil si necesitás operar con el valor numéricamente.
 * @param {string} valorAR
 * @returns {number}
 */
export function parseRipteAR(valorAR) {
  if (!valorAR) return NaN
  return parseFloat(valorAR.replace(/\./g, '').replace(',', '.'))
}

/**
 * Convierte un número JS a formato AR ("8665.19" → "8.665,19").
 * @param {number} num
 * @returns {string}
 */
export function formatRipteAR(num) {
  return num.toLocaleString('es-AR', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  })
}

/**
 * Calcula el coeficiente RIPTE para actualización de IBM:
 *   coef = RIPTE_actual / RIPTE_accidente
 * @param {string} fechaAccidente  "YYYY-MM-DD"
 * @param {string} fechaActual     "YYYY-MM-DD" (opcional, default = último publicado)
 * @returns {number|null}          Coeficiente, o null si falta algún dato.
 */
export function calcularCoeficienteRIPTE(fechaAccidente, fechaActual) {
  const accidente = parseRipteAR(getRipteFechaAccidente(fechaAccidente))
  const actual = fechaActual
    ? parseRipteAR(getRipteFechaAccidente(fechaActual))
    : parseRipteAR(getRipteUltimo().valor)
  if (isNaN(accidente) || isNaN(actual) || accidente === 0) return null
  return actual / accidente
}
